# Shared model gateway. Prefer the workspace root ../.env for live values.
MODEL_GATEWAY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
MODEL_GATEWAY_API_KEY=
DASHSCOPE_API_KEY=

# Pick one configured profile from config.yaml model.profiles.
# You can add/edit profiles in config.yaml without changing code.
MODEL_PROFILE=qwen

# Optional direct overrides. Usually leave these empty and use MODEL_PROFILE.
# MODEL_NAME=qwen-3.7-max
# MODEL_MAX_TOKENS=16000
# MODEL_THINKING=auto

# iFind MCP uses the same key for all iFind servers.
# Use IFIND_MCP_TOKEN when the value should be sent as Authorization: Bearer <token>.
IFIND_MCP_TOKEN=
# Use IFIND_MCP_AUTHORIZATION when iFind gives you the complete raw header value.
# IFIND_MCP_AUTHORIZATION=

# Local development switches
# DCF_BUILDER_DISABLE_MCP=1
# DCF_BUILDER_TEST_MODE=1
