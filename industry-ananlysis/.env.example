# Prefer the workspace root ../.env for live values.
# This file is a local reference only.

# LangSmith tracing. Keep off for local dev unless you really need remote traces.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=market-researcher
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# Model gateway. Defaults match config.yaml.
MODEL_GATEWAY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
MODEL_NAME=qwen-3.7-max
MODEL_GATEWAY_API_KEY=
DASHSCOPE_API_KEY=
MODEL_MAX_TOKENS=16000
MODEL_THINKING=auto

# iFind uses one shared credential across all configured iFind MCP servers.
IFIND_MCP_TOKEN=
# IFIND_MCP_AUTHORIZATION=

# Optional: override MCP URLs/transports without editing config.yaml.
# IFIND_STOCK_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-stock-mcp
# IFIND_STOCK_MCP_TRANSPORT=streamable_http

# Search API keys (override config.yaml search.api_key)
TAVILY_API_KEY=
SERPER_API_KEY=
