# Copy this file to .env and fill in your values.
# Values here override config.yaml.

# LangSmith tracing. Keep off for local dev unless you really need remote traces.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=market-researcher
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# Model — edit these three lines to switch provider/model.
# BabelArk:
# MODEL_BASE_URL=https://api.babelark.com
# MODEL_NAME=claude-sonnet-4.6
#
# MiniMax:
MODEL_BASE_URL=https://api.minimaxi.com
MODEL_NAME=MiniMax-M2.7
#
# DeepSeek:
# MODEL_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat
# MODEL_NAME=deepseek-v4-pro
#
# Alibaba Cloud Bailian / DashScope:
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen3.7-max-preview
# MODEL_NAME=qwen3-max
#
# Recommended: use this unified key variable for the selected provider.
MODEL_API_KEY=
MODEL_MAX_TOKENS=16000
# For DeepSeek V4 + agent tool calling, keep this disabled to avoid
# reasoning_content pass-back errors in multi-turn tool loops.
MODEL_THINKING=disabled

# Optional provider-specific keys. Used only when MODEL_API_KEY is empty.
BABELARK_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ALIBABA_API_KEY=

# MCP overrides.
# Server names in config.yaml use hyphens, but env vars use underscores:
#   ifind-stock -> IFIND_STOCK_*
# For iFind, Authorization is a raw header value, so use *_MCP_AUTHORIZATION.
IFIND_STOCK_MCP_AUTHORIZATION=
IFIND_FUND_MCP_AUTHORIZATION=
IFIND_EDB_MCP_AUTHORIZATION=
IFIND_NEWS_MCP_AUTHORIZATION=
IFIND_BOND_MCP_AUTHORIZATION=
IFIND_GLOBAL_STOCK_MCP_AUTHORIZATION=
IFIND_INDEX_MCP_AUTHORIZATION=

# Optional: override MCP URLs/transports without editing config.yaml.
# IFIND_STOCK_MCP_URL=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-stock-mcp
# IFIND_STOCK_MCP_TRANSPORT=streamable_http

# Generic bearer token form for MCP servers that expect Bearer auth.
CAPIQ_MCP_TOKEN=
FACTSET_MCP_TOKEN=

# Search API keys (override config.yaml search.api_key)
TAVILY_API_KEY=
SERPER_API_KEY=
