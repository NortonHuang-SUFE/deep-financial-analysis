# Core-code-only upload allowlist.
# By default, ignore everything at the workspace root.
*

# Keep repository metadata and the two core project directories.
!/.gitignore
!/.env.example
!/langgraph.json
!/DCF-builder/
!/DCF-builder/**
!/industry-ananlysis/
!/industry-ananlysis/**
!/morning-note/
!/morning-note/**
!/screen/
!/screen/**
!/sector/
!/sector/**
!/thesis/
!/thesis/**

# Secrets and local overrides.
**/.env
**/.env.*
!**/.env.example
**/config.local.yaml
**/*.pem
**/*.key

# Runtime outputs and generated artifacts.
**/out/
**/.langgraph_api/
**/.cache/
**/dist/
**/build/
**/*.egg-info/

# Tests are intentionally excluded from this first core-code upload.
**/tests/
!/morning-note/tests/
!/morning-note/tests/**
!/screen/tests/
!/screen/tests/**
!/sector/tests/
!/sector/tests/**
!/thesis/tests/
!/thesis/tests/**

# Python and tool caches.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Large or potentially proprietary presentation templates.
**/templates/*.pptx

# Local/editor files.
**/.DS_Store
**/.claude/
