# Core-code-only upload allowlist.
# By default, ignore everything at the workspace root.
*

# Keep repository metadata and the two core project directories.
!/.gitignore
!/.env.example
!/README.md
!/README.en.md
!/CHANGELOG.md
!/CHANGELOG.en.md
!/AGENTS.md
!/langgraph.json
!/model-routing.yaml
!/tool-concurrency.yaml
!/docs/
!/docs/**
!/morning-note/
!/morning-note/**
!/orchestrator/
!/orchestrator/**
!/html-image-renderer/
!/html-image-renderer/**
!/financial-agent-runtime/
!/financial-agent-runtime/**

# Secrets and local overrides.
**/.env
**/.env.*
!**/.env.example
**/config.local.yaml
**/*.pem
**/*.key

# Runtime outputs and generated artifacts.
**/out/
**/.langgraph_api/
**/.cache/
**/dist/
**/build/
**/*.egg-info/

# Tests are intentionally excluded from this first core-code upload.
**/tests/
!/morning-note/tests/
!/morning-note/tests/**
!/orchestrator/tests/
!/orchestrator/tests/**
!/html-image-renderer/tests/
!/html-image-renderer/tests/**
!/financial-agent-runtime/tests/
!/financial-agent-runtime/tests/**

# Python and tool caches.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Large or potentially proprietary presentation templates.
**/templates/*.pptx

# Local/editor files.
**/.DS_Store
**/.claude/
