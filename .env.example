# Shared model gateway for all top-level agents.
# 所有顶层 agent 共用的模型网关。
# Keep live credentials in .env. Do not commit .env.
# 真实凭证只放在 .env 中，不要提交 .env。
MODEL_GATEWAY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
MODEL_GATEWAY_API_KEY=
MODEL_NAME=qwen-3.7-max
MODEL_MAX_TOKENS=16000
MODEL_THINKING=auto

# Shared artifact storage root for all agents (LOCAL mode only).
# 所有 agent 共用的产物存储根目录（仅 local 模式生效）。
# Leave empty to write under this repository workspace. Set to a clean folder
# to place every agent's out/ and out/coverage/ artifacts there instead.
# 留空则写入本仓库工作区；填一个干净目录则所有 agent 的 out/ 与
# out/coverage/ 产物改写到该目录。
AGENT_FILE_STORAGE_ROOT=

# Backend mode for the deep-agents filesystem.
# deep-agents 文件系统的后端模式。
#   local   (default) - host filesystem (LocalShellBackend / FilesystemBackend)
#   local   （默认）  - 本机文件系统（LocalShellBackend / FilesystemBackend）
#   daytona           - remote Daytona sandbox (one ephemeral sandbox per process)
#   daytona           - 远端 Daytona 沙箱（每个进程一个临时沙箱）
AGENT_BACKEND=local

# Daytona credentials. Only used when AGENT_BACKEND=daytona.
# Daytona 凭证。仅在 AGENT_BACKEND=daytona 时使用。
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=

# Artifact storage root INSIDE the Daytona sandbox (DAYTONA mode only).
# Daytona 沙箱内部的产物存储根目录（仅 daytona 模式生效）。
# Must be a Linux path that exists/can be created in the sandbox; the host
# AGENT_FILE_STORAGE_ROOT (a macOS path) does not exist there.
# 必须是沙箱内可创建的 Linux 路径；本机的 AGENT_FILE_STORAGE_ROOT（macOS 路径）
# 在沙箱里并不存在。
# DAYTONA_FILE_STORAGE_ROOT=/home/daytona/financial-analysis

# Alibaba DashScope fallback key. Used when MODEL_GATEWAY_API_KEY is empty.
# 阿里 DashScope 备用 key。当 MODEL_GATEWAY_API_KEY 为空时使用。
DASHSCOPE_API_KEY=

# Volcengine Ark fallback key. Used when MODEL_GATEWAY_API_KEY is empty and
# MODEL_GATEWAY_BASE_URL points to ark.cn-beijing.volces.com.
# 火山方舟备用 key。当 MODEL_GATEWAY_API_KEY 为空且网关指向火山方舟时使用。
# MODEL_GATEWAY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=

# iFind MCP uses one shared credential by default.
# iFind MCP 默认使用一个共享凭证。
# Use IFIND_MCP_TOKEN when the value should be sent as Authorization: Bearer <token>.
# 当需要以 Authorization: Bearer <token> 形式发送时，使用 IFIND_MCP_TOKEN。
IFIND_MCP_TOKEN=
# Use IFIND_MCP_AUTHORIZATION when iFind gives the complete raw Authorization header.
# 当 iFind 给出完整原始 Authorization 头时，使用 IFIND_MCP_AUTHORIZATION。
# IFIND_MCP_AUTHORIZATION=

# Optional per-server URL/transport overrides. Credentials stay shared above.
# 可选的按服务器 URL/传输方式覆盖。凭证仍沿用上面的共享配置。
# IFIND_STOCK_MCP_URL=
# IFIND_STOCK_MCP_TRANSPORT=streamable_http

# Eastmoney 妙想 MX DS MCP credential. Sent as the `em_api_key` header for
# `mx-ds-mcp`; keep the live key only in .env.
# 东方财富妙想 MX DS MCP 凭证。作为 `mx-ds-mcp` 的 `em_api_key` header 发送；
# 真实 key 只放在 .env。
MX_DS_MCP_API_KEY=
# Optional endpoint override for the MX DS MCP server.
# MX DS MCP server 的可选地址覆盖。
# MX_DS_MCP_URL=https://mxapi.eastmoney.com/mxds/mcp
# MX_DS_MCP_TRANSPORT=streamable-http

# External-tool concurrency limits live in tool-concurrency.yaml at the
# workspace root (iFind and MX DS are capped there so parallel subagents do not
# overwhelm them). Set TOOL_CONCURRENCY_CONFIG to point at a different file; if
# the file is absent, nothing is limited.
# 外部工具的并发上限配置在工作区根目录的 tool-concurrency.yaml（iFind 和 MX DS
# 在此限流，避免并行子 agent 打爆外部服务）。可用 TOOL_CONCURRENCY_CONFIG 指向其它文件；
# 文件不存在则不做任何限制。
# TOOL_CONCURRENCY_CONFIG=

# Local development switches.
# 本地开发开关。
# MORNING_NOTE_TEST_MODE=1
# MORNING_NOTE_DISABLE_MCP=1
# MORNING_NOTE_OUTPUT_TIMESTAMP=20260602-090000
# STOCK_SCREEN_TEST_MODE=1
# STOCK_SCREEN_DISABLE_MCP=1
# STOCK_SCREEN_OUTPUT_TIMESTAMP=20260602-090000
# SECTOR_RESEARCH_TEST_MODE=1
# SECTOR_RESEARCH_DISABLE_MCP=1
# SECTOR_RESEARCH_OUTPUT_TIMESTAMP=20260602-090000
# THESIS_TRACKER_TEST_MODE=1
# THESIS_TRACKER_DISABLE_MCP=1
# THESIS_TRACKER_OUTPUT_TIMESTAMP=20260602-090000
LANGCHAIN_TRACING_V2=true
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
